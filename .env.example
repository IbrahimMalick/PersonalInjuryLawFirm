# ── Required ────────────────────────────────────────────────────────────────
# The model key. Without it, live-mode triage marks every lead "needs
# attention" (a person handles the raw message); demo mode runs on cached
# results.
ANTHROPIC_API_KEY=sk-ant-...

# Public URL of this instance (no trailing slash). Required in production —
# webhook signature verification and the settings screen derive URLs from it.
PUBLIC_BASE_URL=https://intake.yourfirm.com

# ── Platform operators ──────────────────────────────────────────────────────
# Comma-separated emails of YOUR team's accounts (sign up normally first).
# Grants the /operator console: every firm's onboarding state, Twilio number
# provisioning. Not for firm users.
OPERATOR_EMAILS=you@yourcompany.com

# ── Mode ────────────────────────────────────────────────────────────────────
# "live" (default) = the product. "demo" = the sales demo: seeded leads,
# simulated clock, no auth.
NIGHTSHIFT_MODE=live

# ── Storage ─────────────────────────────────────────────────────────────────
# Postgres connection string (Neon / Supabase / Vercel Postgres / RDS).
# Leave unset locally: an embedded Postgres (PGlite) runs in-process at ./data/pg.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ── Twilio: SMS, voicemail & WhatsApp (leave unset to run simulated) ───────
# One platform account; each firm gets its own number (set per firm in the
# /operator console — inbound routes by the number dialed).
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_PHONE_NUMBER=+17185550140   # optional platform-wide fallback sender

# ── Email (leave unset to run simulated) ────────────────────────────────────
# Outbound via SendGrid; inbound via SendGrid Inbound Parse pointed at
# /api/inbound/email?token=<firm's token — shown per firm in /operator>
# SENDGRID_API_KEY=SG.xxxxxxxx
# EMAIL_FROM_ADDRESS=intake@yourplatform.com
# EMAIL_FROM_NAME=Nightshift Intake

# ── Stripe billing (leave unset to run every firm free, no trial clock) ─────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...          # the monthly subscription price
# STRIPE_WEBHOOK_SECRET=whsec_...    # from the webhook endpoint you create

# ── Serverless job sweeper (Vercel) ─────────────────────────────────────────
# Vercel Cron calls /api/jobs/run each minute with this as a Bearer token.
# CRON_SECRET=a-long-random-string

# ── Tuning (defaults are fine) ──────────────────────────────────────────────
# NIGHTSHIFT_JOB_MAX_ATTEMPTS=4
