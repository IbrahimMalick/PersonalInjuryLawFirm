# ── Required ────────────────────────────────────────────────────────────────
# The model key. Without it, live-mode triage marks every lead "needs
# attention" (a person handles the raw message); demo mode runs on cached
# results.
ANTHROPIC_API_KEY=sk-ant-...

# Public URL of this instance (no trailing slash). Required in production —
# webhook signature verification and the settings screen derive URLs from it.
PUBLIC_BASE_URL=https://intake.yourfirm.com

# ── Platform operators ──────────────────────────────────────────────────────
# Comma-separated emails of YOUR team's accounts (sign up normally first).
# Grants the /operator console: every firm's onboarding state, Twilio number
# provisioning. Not for firm users.
OPERATOR_EMAILS=you@yourcompany.com

# ── Mode ────────────────────────────────────────────────────────────────────
# "live" (default) = the product. "demo" = the sales demo: seeded leads,
# simulated clock, no auth.
NIGHTSHIFT_MODE=live

# ── Storage ─────────────────────────────────────────────────────────────────
# Postgres connection string (Neon / Supabase / Vercel Postgres / RDS).
# Leave unset locally: an embedded Postgres (PGlite) runs in-process at ./data/pg.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ── Twilio: SMS, voicemail & WhatsApp (leave unset to run simulated) ───────
# One platform account; each firm gets its own number (set per firm in the
# /operator console — inbound routes by the number dialed).
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_PHONE_NUMBER=+17185550140   # optional platform-wide fallback sender

# ── Email (leave unset to run simulated) ────────────────────────────────────
# Outbound email provider for verification, password-reset, and approved
# replies. EMAIL_PROVIDER picks it:
#
#   unset / "sendgrid"  → SendGrid (default)
#     SENDGRID_API_KEY, EMAIL_FROM_ADDRESS, EMAIL_FROM_NAME
#     inbound: SendGrid Inbound Parse → /api/inbound/email?token=<firm token>
#
#   "ghl"               → GoHighLevel (LeadConnector API v2)
#     GHL_API_TOKEN     Private Integration token (pit-...); scopes:
#                       contacts.write, contacts.readonly, conversations.write,
#                       conversations/message.write, conversations/message.readonly
#     GHL_LOCATION_ID   the sub-account id
#     GHL_EMAIL_FROM    a from address on a domain verified in that location's
#                       Email Services, e.g. intake@yourdomain.com
#     inbound: not built for GHL yet — see docs/
#
# EMAIL_PROVIDER=ghl
# SENDGRID_API_KEY=SG.xxxxxxxx
# EMAIL_FROM_ADDRESS=intake@yourplatform.com
# EMAIL_FROM_NAME=Nightshift Intake
# GHL_API_TOKEN=pit-xxxxxxxx
# GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx
# GHL_EMAIL_FROM=intake@yourdomain.com

# ── Push every lead into GoHighLevel as a contact + note ────────────────────
# Independent of EMAIL_PROVIDER; needs GHL_API_TOKEN + GHL_LOCATION_ID (and the
# token's contacts.write scope). Each processed lead upserts a GHL contact,
# tagged (Nightshift Lead, case type, routing, CONFLICT…) with a note holding
# the full triage summary. All firms sync into the one location.
# GHL_SYNC_LEADS=true

# ── Stripe billing (leave unset to run every firm free, no trial clock) ─────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...          # the monthly subscription price
# STRIPE_WEBHOOK_SECRET=whsec_...    # from the webhook endpoint you create

# ── CRM integrations ────────────────────────────────────────────────────────
# Most integrations are configured per firm in Settings → Integrations (Clio
# Grow inbox token, HubSpot private-app token, Filevine PAT, CallRail webhook,
# generic webhook for GoHighLevel/Zapier). Only the OAuth providers need
# platform-level developer apps here; without these, their cards show
# "via onboarding call" and everything else still works.
# LAWMATICS_CLIENT_ID=...          # Lawmatics developer app (ask support@lawmatics.com)
# LAWMATICS_CLIENT_SECRET=...
# MYCASE_CLIENT_ID=...             # MyCase developer app (mycaseapi.stoplight.io)
# MYCASE_CLIENT_SECRET=...

# ── Serverless job sweeper (Vercel) ─────────────────────────────────────────
# Vercel Cron calls /api/jobs/run each minute with this as a Bearer token.
# CRON_SECRET=a-long-random-string

# ── Tuning (defaults are fine) ──────────────────────────────────────────────
# NIGHTSHIFT_JOB_MAX_ATTEMPTS=4
